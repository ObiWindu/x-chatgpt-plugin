# Hostim.dev PROJECT-LEVEL environment variables.
# Copy this file to hostim/global.env and set real production values.
# Never commit hostim/global.env.

PUBLIC_BASE_URL=https://YOUR_DOMAIN.example.com
X_CLIENT_ID=replace_me
X_CLIENT_SECRET=replace_me
X_REDIRECT_URI=https://YOUR_DOMAIN.example.com/auth/x/callback

CHATGPT_CLIENT_ID=chatgpt-x-publisher
CHATGPT_CLIENT_SECRET=replace_with_a_long_random_secret

# Exact callback URL generated by the ChatGPT Action OAuth configuration.
CHATGPT_ALLOWED_REDIRECT_URIS=https://chatgpt.com/aip/g-REPLACE/actions/oauth/callback

# Generate:
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
TOKEN_ENCRYPTION_KEY_B64=replace_me

COOKIE_SECURE=true
